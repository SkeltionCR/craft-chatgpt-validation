+//! Windows-only ChatGPT connection: other platforms keep the original desktop app.
+#![forbid(unsafe_code)]
+pub fn wrap<A: eframe::App>(inner: A) -> A {
+    inner
+}
+pub fn cli() -> Option<Result<(), String>> {
+    let argument = std::env::args().nth(1)?;
+    match argument.as_str() {
+        "--chatgpt-status" | "--chatgpt-sign-in" | "--chatgpt-disconnect" | "--chatgpt-refresh" => {
+            Some(Err("This ChatGPT connection draft supports Windows only".into()))
+        }
+        _ => None,
+    }
+}
