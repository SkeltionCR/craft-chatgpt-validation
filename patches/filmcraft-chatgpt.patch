+/// Keep a frequently used playback graph when unrelated graphs fill the cache.
+/// Clearing the entire cache forces that graph to repeat its effect pre-roll.
+#[derive(Default)]
+struct GraphCache {
+    graphs: HashMap<u64, Vec<GraphState>>,
+    recent: VecDeque<u64>,
+}
+
+impl GraphCache {
+    fn touch(&mut self, key: u64) {
+        self.recent.retain(|k| *k != key);
+        self.recent.push_back(key);
+    }
+
+    fn take(&mut self, key: u64, start: i64) -> Option<GraphState> {
+        let taken = self.graphs.get_mut(&key).and_then(|v| v.iter().position(|g| g.next_out == start).map(|i| v.swap_remove(i)));
+        if self.graphs.contains_key(&key) {
+            self.touch(key);
+        }
+        taken
+    }
+
+    fn put(&mut self, key: u64, state: GraphState) {
+        let v = self.graphs.entry(key).or_default();
+        v.push(state);
+        if v.len() > 4 {
+            v.remove(0);
+        }
+        self.touch(key);
+        while self.graphs.len() > 64 {
+            let Some(oldest) = self.recent.pop_front() else { break };
+            self.graphs.remove(&oldest);
+        }
+    }
+}
+
+fn cache() -> &'static Mutex<GraphCache> {
+    static C: OnceLock<Mutex<GraphCache>> = OnceLock::new();
     C.get_or_init(Default::default)
 }
 
