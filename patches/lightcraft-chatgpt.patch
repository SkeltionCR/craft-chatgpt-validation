+    fn signed_claims(value: &serde_json::Value) -> (String, JwkSet) {
+        let mut header = jsonwebtoken::Header::new(Algorithm::ES256);
+        header.kid = Some("test-only".into());
+        let token = jsonwebtoken::encode(&header, value, &jsonwebtoken::EncodingKey::from_ec_pem(TEST_KEY.as_bytes()).unwrap()).unwrap();
+        let keys = serde_json::from_str("{\"keys\": [{\"kty\": \"EC\", \"x\": \"HqdTupWrCnLHYflf4l7M2VwhlfI6qGIQhvXqWk6ARZ4\", \"y\": \"wA3YLi93giQUTtW-gnLp1b2whB-3xY2lqCBrT0FDKjE\", \"crv\": \"P-256\", \"kid\": \"test-only\", \"alg\": \"ES256\", \"use\": \"sig\"}]}").unwrap();
