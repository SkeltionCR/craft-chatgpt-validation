+fn gauss_relief(e: &mut Enc, img: &GpuImage, sigma: f64) -> GpuImage {
+    let mut cur = img.clone();
+    if sigma <= 0.05 {
+        return cur;
+    }
+    let radii = box_radii(sigma, 3);
+    for vertical in [false, true] {
+        for &radius in &radii {
