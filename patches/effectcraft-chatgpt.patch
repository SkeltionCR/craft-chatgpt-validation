+/// Read-only status and explicit auth commands for headless automation. Never emit tokens.
+pub fn cli() -> Option<Result<(), String>> {
+    let argument = std::env::args().nth(1)?;
+    let action = match argument.as_str() {
+        "--chatgpt-status" => None,
+        "--chatgpt-sign-in" => Some("sign_in"),
+        "--chatgpt-disconnect" => Some("disconnect"),
+        "--chatgpt-refresh" => Some("refresh"),
+        _ => return None,
+    };
+    Some((|| {
+        let runtime = Runtime::new();
+        let deadline = Instant::now() + Duration::from_secs(240);
+        while runtime.status().busy && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        if runtime.status().busy {
+            return Err("ChatGPT connection initialization timed out".into());
+        }
+        if runtime.status().last_action_ok == Some(false) {
+            return Err(runtime.status().message);
+        }
+        if let Some(action) = action {
+            runtime.dispatch(action);
+        }
+        while runtime.status().busy && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        if runtime.status().busy {
+            return Err("ChatGPT command timed out".into());
+        }
+        let status = runtime.status();
+        let output = serde_json::to_string(&status).map_err(|_| "Could not serialize connection status")?;
+        writeln!(std::io::stdout().lock(), "{output}").map_err(|_| "Could not write ChatGPT command status")?;
+        if status.last_action_ok == Some(false) {
+            return Err(status.message);
+        }
+        Ok(())
+    })())
+}
