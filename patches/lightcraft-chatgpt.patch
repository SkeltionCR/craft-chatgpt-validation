+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn pkce_rfc7636_vector_and_new_registration() {
+        let url = authorization("urn:uuid:test", "http://127.0.0.1:1455/auth/callback", "state", "nonce", "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk", None).unwrap();
+        let q: HashMap<_, _> = url.query_pairs().collect();
+        assert_eq!(q.get("code_challenge").unwrap(), "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM");
+        assert_eq!(q.get("client_id").unwrap(), "dynamic_agent_client"); assert_eq!(q.get("agent_name_hint").unwrap(), APP);
+        assert_eq!(q.get("redirect_uri").unwrap(), "http://127.0.0.1:1455/auth/callback");
+    }
+    #[test] fn callback_requires_state_code_and_issued_client() {
+        assert!(callback("/auth/callback?state=wrong&code=x&client_id=oaiapp_x", "right", None).is_err());
+        assert!(callback("/auth/callback?state=s&code=x&client_id=dynamic_agent_client", "s", None).is_err());
+        assert!(callback("/auth/callback?state=s&state=s&code=x&client_id=oaiapp_x", "s", None).is_err());
+        assert!(callback("/auth/callback?state=s&error=access_denied", "s", None).is_err());
+        assert_eq!(callback("/auth/callback?state=s&code=x&client_id=oaiapp_x", "s", None).unwrap(), ("oaiapp_x".into(), "x".into()));
+    }
+    fn account() -> Account { Account { client_id: "oaiapp_test".into(), subject: "sub".into(), email: Some("a@example.test".into()), id_token: "secret-id".into(), access_token: "secret-access".into(), refresh_token: Some("secret-refresh".into()), scopes: vec!["chatgpt.tokens.use.direct".into(), "resource.invoke".into()], expires_at: u64::MAX } }
+    #[test] fn returning_callback_cannot_replace_client() {
+        let a = account(); assert!(callback("/auth/callback?state=s&code=x&client_id=oaiapp_other", "s", Some(&a)).is_err());
+        assert_eq!(callback("/auth/callback?state=s&code=x", "s", Some(&a)).unwrap().0, a.client_id);
+        let url = authorization("host", "http://127.0.0.1:42/auth/callback", "s", "n", "v", Some(&a)).unwrap();
+        assert!(!url.query_pairs().any(|(k, _)| k == "agent_name_hint"));
+    }
+    #[test] fn status_never_exposes_tokens_and_requires_both_scopes() {
+        let mut a = account(); let state = snapshot(Some(&a), "test".into()); assert!(state.plan_usage);
+        let json = serde_json::to_string(&state).unwrap(); assert!(!json.contains("secret-")); assert!(!json.contains("token"));
+        a.scopes.pop(); assert!(!snapshot(Some(&a), String::new()).plan_usage);
+        a.expires_at = 0; assert!(!snapshot(Some(&a), String::new()).connected);
+    }
+    #[test] fn forged_id_token_is_rejected() {
+        let keys = JwkSet { keys: vec![] };
+        assert!(validate_claims("not-a-jwt", "oaiapp_x", Some("n"), None, &keys).is_err());
+    }
+
+    // Synthetic test-only EC key; never used by the production client.
+    const TEST_KEY: &str = "-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgPpCbf/ANRkOx/B8M\nRpG9NKg4xyby9/JLBNgBCvqtci+hRANCAAQep1O6lasKcsdh+V/iXszZXCGV8jqo\nYhCG9epaToBFnsAN2C4vd4IkFE7VvoJy6dW9sIQft8WNpagga09BQyox\n-----END PRIVATE KEY-----\n";
+    fn signed_claims(value: &serde_json::Value) -> (String, JwkSet) {
+        let mut header = jsonwebtoken::Header::new(Algorithm::ES256);
+        header.kid = Some("test-only".into());
+        let token = jsonwebtoken::encode(&header, value, &jsonwebtoken::EncodingKey::from_ec_pem(TEST_KEY.as_bytes()).unwrap()).unwrap();
+        let keys = serde_json::from_str("{\"keys\": [{\"kty\": \"EC\", \"x\": \"HqdTupWrCnLHYflf4l7M2VwhlfI6qGIQhvXqWk6ARZ4\", \"y\": \"wA3YLi93giQUTtW-gnLp1b2whB-3xY2lqCBrT0FDKjE\", \"crv\": \"P-256\", \"kid\": \"test-only\", \"alg\": \"ES256\", \"use\": \"sig\"}]}").unwrap();
+        (token, keys)
+    }
+    #[test] fn signed_identity_requires_issuer_audience_nonce_and_expiry() {
+        let time = now().unwrap();
+        let claims = serde_json::json!({"sub": "sub", "email": "test@example.test", "iat": time,
+            "exp": time + 300, "iss": ISSUER, "aud": "oaiapp_test", "nonce": "nonce"});
+        let (token, keys) = signed_claims(&claims);
+        assert!(validate_claims(&token, "oaiapp_test", Some("nonce"), Some(&account()), &keys).is_ok());
+        for (field, value) in [("iss", serde_json::json!("https://invalid.test")),
+            ("aud", serde_json::json!("oaiapp_other")), ("nonce", serde_json::json!("wrong")),
+            ("sub", serde_json::json!("other-user")), ("exp", serde_json::json!(0)),
+            ("iat", serde_json::json!(time + 600))] {
+            let mut changed = claims.clone(); changed[field] = value;
+            let (token, keys) = signed_claims(&changed);
+            assert!(validate_claims(&token, "oaiapp_test", Some("nonce"), Some(&account()), &keys).is_err(), "accepted invalid {field}");
+        }
+    }
+    #[test] fn encryption_rejects_corruption() {
+        let cipher = Aes256Gcm::new_from_slice(&[7u8; 32]).unwrap(); let nonce = Nonce::from([1u8; 12]);
+        let mut encrypted = cipher.encrypt(&nonce, b"credential".as_ref()).unwrap();
+        assert_eq!(cipher.decrypt(&nonce, encrypted.as_slice()).unwrap(), b"credential");
+        *encrypted.first_mut().unwrap() ^= 1; assert!(cipher.decrypt(&nonce, encrypted.as_slice()).is_err());
+    }
