+/// Draw the app name with its left edge at `left_center` (vertically centred).
+/// Returns the drawn rect so adjacent community controls keep their spacing.
+pub fn paint_wordmark(ui: &egui::Ui, left_center: egui::Pos2, height: f32, _dark: bool) -> Option<egui::Rect> {
+    let galley = ui.painter().layout_no_wrap("FilmCraft".to_owned(), egui::FontId::proportional(height), ui.visuals().text_color());
+    let rect = egui::Rect::from_min_size(egui::pos2(left_center.x, left_center.y - galley.size().y / 2.0), galley.size());
+    ui.painter().galley(rect.min, galley, ui.visuals().text_color());
+    Some(rect)
 }
