+    #[test]
+    fn signed_identity_requires_issuer_audience_nonce_and_expiry() {
+        let time = now().unwrap();
+        let claims = serde_json::json!({"sub": "sub", "email": "test@example.test", "iat": time,
+            "exp": time + 300, "iss": ISSUER, "aud": "oaiapp_test", "nonce": "nonce"});
+        let (token, keys) = signed_claims(&claims);
+        assert!(validate_claims(&token, "oaiapp_test", Some("nonce"), Some(&account()), &keys).is_ok());
+        for (field, value) in [
+            ("iss", serde_json::json!("https://invalid.test")),
+            ("aud", serde_json::json!("oaiapp_other")),
+            ("nonce", serde_json::json!("wrong")),
+            ("sub", serde_json::json!("other-user")),
+            ("exp", serde_json::json!(0)),
+            ("iat", serde_json::json!(time + 600)),
+        ] {
+            let mut changed = claims.clone();
+            changed[field] = value;
+            let (token, keys) = signed_claims(&changed);
+            assert!(validate_claims(&token, "oaiapp_test", Some("nonce"), Some(&account()), &keys).is_err(), "accepted invalid {field}");
+        }
+    }
