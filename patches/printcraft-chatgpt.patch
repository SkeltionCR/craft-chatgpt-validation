+        let cleaned = Arc::new(AtomicBool::new(false));
+        let (fixture, _receiver) = preview_app();
+        let cancelled = fixture.runtime.cancel.clone();
+        let mut app = ConnectedApp { inner: ExitEditor(cleaned.clone()), runtime: fixture.runtime, panel: false };
+        eframe::App::on_exit(&mut app, None);
+        assert!(cleaned.load(Ordering::SeqCst));
+        assert!(cancelled.load(Ordering::SeqCst));
+    }
+
+    #[test]
+    fn chatgpt_panel_dispatches_sign_in_and_cancellation() {
+        use egui_kittest::kittest::Queryable;
+        let (app, receiver) = preview_app();
+        let mut harness = egui_kittest::Harness::builder().with_size(egui::vec2(960.0, 640.0)).with_max_steps(64).build_eframe(move |_| app);
+        harness.run_steps(8);
+        harness.get_by_label("Continue with ChatGPT").click();
+        harness.run_steps(4);
+        assert_eq!(receiver.try_recv().unwrap(), "sign_in");
+        assert!(harness.state().runtime.status().busy);
+        harness.get_by_label("Cancel sign-in").click();
+        harness.run_steps(4);
+        assert!(harness.state().runtime.cancel.load(Ordering::SeqCst));
+    }
+
+    #[test]
+    #[ignore = "Requires an offscreen graphics adapter; requested explicitly in Windows CI"]
+    fn chatgpt_panel_offscreen_preview() {
+        let (app, _receiver) = preview_app();
+        let mut harness = egui_kittest::Harness::builder()
+            .with_size(egui::vec2(960.0, 640.0))
+            .with_pixels_per_point(1.0)
+            .with_max_steps(64)
+            .wgpu()
+            .build_eframe(move |_| app);
+        harness.run_steps(12);
+        let output = std::env::var_os("CRAFT_SNAPSHOT_PATH").expect("CI must choose a scratch output path for the panel preview");
+        harness.render().expect("Render the actual connection panel").save(output).expect("Save the connection panel preview");
+    }
+}
