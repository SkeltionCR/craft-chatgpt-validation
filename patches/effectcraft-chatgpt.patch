+        let angle = select(0.0, 3.141592653589793, negative_x);
+        return select(angle, -angle, negative_y);
+    }
+    var z = min(ax, ay) / hi;
+    var base = 0.0;
+    if (z > 0.414213562373095) {
+        z = (z - 1.0) / (z + 1.0);
