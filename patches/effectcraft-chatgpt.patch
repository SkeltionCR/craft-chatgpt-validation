+/// Desktop-only decoration: forward every App lifecycle hook to the original editor.
+pub struct ConnectedApp<A> {
+    inner: A,
+    runtime: Runtime,
+    panel: bool,
+}
+pub fn wrap<A: eframe::App>(inner: A) -> ConnectedApp<A> {
+    ConnectedApp { inner, runtime: Runtime::new(), panel: false }
+}
+impl<A: eframe::App> eframe::App for ConnectedApp<A> {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.inner.logic(ctx, frame);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        let ctx = ui.ctx().clone();
+        self.inner.ui(ui, frame);
+        egui::Area::new(egui::Id::new("chatgpt.connection.button")).anchor(egui::Align2::RIGHT_BOTTOM, [-12.0, -12.0]).order(egui::Order::Foreground).show(
+            &ctx,
+            |ui| {
+                if ui.button("ChatGPT connection…").clicked() {
+                    self.panel = true;
+                }
+            },
+        );
+        if !self.panel {
+            return;
+        }
+        let status = self.runtime.status();
+        egui::Window::new(format!("{APP} · ChatGPT")).id(egui::Id::new("chatgpt.connection")).open(&mut self.panel).resizable(false).show(&ctx, |ui| {
+            ui.label("Connect your ChatGPT account");
+            ui.label("This connects your account and requests optional plan usage. It does not run AI or read your ChatGPT conversations.");
+            if let Some(email) = &status.email {
+                ui.label(email);
+            }
+            ui.label(if status.connected { "Connected" } else { "Disconnected or session expired" });
+            if status.plan_usage {
+                ui.label("ChatGPT plan permission granted. AI editing is not implemented in this change.");
+            }
+            ui.label(&status.message);
+            ui.add_enabled_ui(!status.busy, |ui| {
+                if ui.button("Continue with ChatGPT").clicked() {
+                    self.runtime.dispatch("sign_in");
+                }
+                if status.expires_at.is_some() && ui.button("Renew connection").clicked() {
+                    self.runtime.dispatch("refresh");
+                }
+                if ui.button("Disconnect").clicked() {
+                    self.runtime.dispatch("disconnect");
+                }
+            });
+            if status.busy {
+                ui.spinner();
+                if ui.button("Cancel sign-in").clicked() {
+                    self.runtime.cancel.store(true, Ordering::SeqCst);
+                }
+                ctx.request_repaint_after(Duration::from_millis(100));
+            }
+            ui.hyperlink_to("Manage usage in ChatGPT", "https://chatgpt.com/settings/usage");
+        });
+    }
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.inner.save(storage);
+    }
+    fn on_exit(&mut self) {
+        self.runtime.cancel.store(true, Ordering::SeqCst);
+        self.inner.on_exit();
+    }
+    fn auto_save_interval(&self) -> Duration {
+        self.inner.auto_save_interval()
+    }
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.inner.clear_color(visuals)
+    }
+    fn persist_egui_memory(&self) -> bool {
+        self.inner.persist_egui_memory()
+    }
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        self.inner.raw_input_hook(ctx, raw);
+    }
+}
