+            let mut p = Params::default();
+            p.u[0] = [radius as u32, vertical as u32, 0, 0];
+            p.f[0][0] = 1.0 / (2 * radius + 1) as f32;
+            cur = kernel(e, "ftr_plane_box", &p, &cur, None, None);
+        }
+    }
