+fn atan2_p(y: f32, x: f32) -> f32 {
+    let negative_x = (bitcast<u32>(x) & 0x80000000u) != 0u;
+    let negative_y = (bitcast<u32>(y) & 0x80000000u) != 0u;
+    let ax = abs(x);
+    let ay = abs(y);
+    let hi = max(ax, ay);
