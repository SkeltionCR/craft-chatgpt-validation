+    }
+    let zz = z * z;
+    var poly = -1.0 / 19.0;
+    poly = 1.0 / 17.0 + zz * poly;
+    poly = -1.0 / 15.0 + zz * poly;
+    poly = 1.0 / 13.0 + zz * poly;
+    poly = -1.0 / 11.0 + zz * poly;
+    poly = 1.0 / 9.0 + zz * poly;
+    poly = -1.0 / 7.0 + zz * poly;
+    poly = 1.0 / 5.0 + zz * poly;
+    poly = -1.0 / 3.0 + zz * poly;
+    var angle = base + z + z * zz * poly;
+    if (ay > ax) { angle = 1.5707963267948966 - angle; }
+    if (negative_x) { angle = 3.141592653589793 - angle; }
+    return select(angle, -angle, negative_y);
